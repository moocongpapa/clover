generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  MEMBER
  OFFICER
  SECRETARY
  VICE_PRESIDENT
  PRESIDENT
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum VoteChoice {
  ATTEND
  ABSENT
  LATE
}

enum NotificationType {
  CREATED
  REMINDER
  CHANGED
  CANCELLED
  JOIN_REQUEST
  JOIN_APPROVED
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                  String         @id @default(cuid())
  kakaoId             String         @unique
  displayName         String
  profileImageUrl     String?
  gender              Gender?
  birthYear           Int?
  birthDate           DateTime?
  phoneNumber         String?
  bio                 String?
  kakaoChannelUserKey String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  memberships         GroupMember[]
  createdEvents       Event[]        @relation("EventCreator")
  votes               Vote[]
  notifications       NotificationLog[]
  triggeredNotifications NotificationLog[] @relation("NotificationActor")
  createdTeamSplits   EventTeamSplit[] @relation("TeamSplitCreator")
  teamAssignments     EventTeamAssignment[]
}

model Group {
  id              String        @id @default(cuid())
  name            String
  description     String
  profileImageUrl String?
  category        String
  activitySido     String?
  activitySigungu  String?
  activityDistrict String?
  activityTown     String?
  activityRegion   String?
  bankName         String?
  bankAccountNumber String?
  bankAccountHolder String?
  isPublic        Boolean       @default(true)
  inviteCode      String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  members         GroupMember[]
  events          Event[]
  notifications   NotificationLog[]
}

model GroupMember {
  id        String       @id @default(cuid())
  userId    String
  groupId   String
  role      MemberRole   @default(MEMBER)
  status    MemberStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Event {
  id          String      @id @default(cuid())
  groupId     String
  title       String
  date        DateTime
  startTime   String
  endTime     String?
  location    String
  description String
  status      EventStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("EventCreator", fields: [createdById], references: [id])
  votes       Vote[]
  notifications NotificationLog[]
  teamSplit   EventTeamSplit?

  @@index([groupId, date])
  @@index([date])
}

model EventTeamSplit {
  id          String   @id @default(cuid())
  eventId     String   @unique
  teamCount   Int
  createdById String
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TeamSplitCreator", fields: [createdById], references: [id])
  assignments EventTeamAssignment[]
}

model EventTeamAssignment {
  id        String         @id @default(cuid())
  splitId   String
  userId    String
  teamLabel String
  split     EventTeamSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([splitId, userId])
  @@index([splitId, teamLabel])
}

model Vote {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  choice    VoteChoice
  votedAt   DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model NotificationLog {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  message     String           @default("")
  readAt      DateTime?
  sentAt      DateTime         @default(now())
  eventId     String?
  groupId     String?
  actorUserId String?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, type])
  @@index([userId, eventId, type])
  @@index([userId, readAt])
}
