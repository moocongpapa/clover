generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  MEMBER
  OFFICER
  SECRETARY
  VICE_PRESIDENT
  PRESIDENT
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum VoteChoice {
  ATTEND
  ABSENT
  LATE
}

enum NotificationType {
  CREATED
  REMINDER
  CHANGED
  CANCELLED
  JOIN_REQUEST
  JOIN_APPROVED
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                     String                @id @default(cuid())
  kakaoId                String                @unique
  displayName            String
  profileImageUrl        String?
  gender                 Gender?
  birthYear              Int?
  birthDate              DateTime?
  isEarlyYear            Boolean               @default(false)
  phoneNumber            String?
  bio                    String?
  kakaoChannelUserKey    String?
  fcmToken               String?
  kakaoNotifyEnabled     Boolean               @default(true)
  pushNotifyEnabled      Boolean               @default(true)
  cloverScore            Float                 @default(0.0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  memberships            GroupMember[]
  createdEvents          Event[]               @relation("EventCreator")
  votes                  Vote[]
  notifications          NotificationLog[]
  triggeredNotifications NotificationLog[]     @relation("NotificationActor")
  createdTeamSplits      EventTeamSplit[]      @relation("TeamSplitCreator")
  teamAssignments        EventTeamAssignment[]
  role                   String                @default("MEMBER")
  isBlocked              Boolean               @default(false)
  announcements          Announcement[]
  officerHistories       OfficerHistory[]
  payments               FeePayment[]
  recordedPayments       FeePayment[]          @relation("RecordedPayments")
  chatMessages           ChatMessage[]
  comments               Comment[]
  uploadedMedia          GroupMedia[]
  profileCards           UserProfileCard[]
}

model Group {
  id                String            @id @default(cuid())
  name              String
  description       String
  profileImageUrl   String?
  category          String
  activitySido      String?
  activitySigungu   String?
  activityDistrict  String?
  activityTown      String?
  activityRegion    String?
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  isPublic          Boolean           @default(true)
  inviteCode        String            @unique
  maxMembers        Int               @default(50)
  customSportName   String? // 기타 스포츠 입력 필드
  monthlyFee        Int? // 정기 회비 금액 (원)
  dueDay            Int? // 회비 납부 마감일 (1~28)
  officerFeeExempt  Boolean           @default(false) // 운영진 회비 면제 여부
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           GroupMember[]
  events            Event[]
  notifications     NotificationLog[]
  arenas            GroupArena[]
  officerHistories  OfficerHistory[]
  payments          FeePayment[]
  chatMessages      ChatMessage[]
  announcements     Announcement[]
  media             GroupMedia[]

  @@index([activityRegion])
  @@index([category])
}

model GroupMember {
  id            String           @id @default(cuid())
  userId        String
  groupId       String
  role          MemberRole       @default(MEMBER)
  status        MemberStatus     @default(PENDING)
  userStatus    String           @default("HEALTHY") // HEALTHY (튼튼), INJURED (회복중), UNAVAILABLE (활동불가)
  profileCardId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profileCard   UserProfileCard? @relation(fields: [profileCardId], references: [id], onDelete: SetNull)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Event {
  id              String            @id @default(cuid())
  groupId         String
  title           String
  date            DateTime
  startTime       String
  endTime         String?
  location        String
  description     String
  status          EventStatus       @default(ACTIVE)
  cancelReason    String?
  createdById     String?
  reminderOffsets String            @default("24,1") // 이벤트 시작 몇 시간 전에 알림을 보낼지 쉼표로 구분
  publishAt       DateTime?         // 일정 오픈 시점 (null이면 즉시 공개)
  openDaysBefore  Int?              @default(3) // 며칠 전 오픈 설정 (기본 3일 전)
  openTime        String?           @default("12:00") // 몇 시 오픈 설정 (기본 낮 12시)
  isNotified      Boolean           @default(false) // 오픈 알림 발송 완료 여부
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  group           Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  votes           Vote[]
  notifications   NotificationLog[]
  teamSplits      EventTeamSplit[]
  comments        Comment[]

  @@index([groupId, date])
  @@index([date])
  @@index([createdById])
  @@index([status])
  @@index([publishAt])
}

model EventTeamSplit {
  id          String                @id @default(cuid())
  eventId     String
  round       Int                   @default(1)
  teamCount   Int
  createdById String?
  createdAt   DateTime              @default(now())
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("TeamSplitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments EventTeamAssignment[]

  @@index([eventId])
  @@unique([eventId, round])
}

model EventTeamAssignment {
  id        String         @id @default(cuid())
  splitId   String
  userId    String
  teamLabel String
  split     EventTeamSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([splitId, userId])
  @@index([splitId, teamLabel])
}

model Vote {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  choice    VoteChoice
  votedAt   DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model NotificationLog {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  message     String           @default("")
  readAt      DateTime?
  sentAt      DateTime         @default(now())
  eventId     String?
  groupId     String?
  actorUserId String?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, type])
  @@index([userId, eventId, type])
  @@index([userId, readAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupArena {
  id        String @id @default(cuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  placeName String // 구장명 (예: 펜타시티풋살장)
  address   String // 구장 전체 주소

  @@index([groupId])
}

model OfficerHistory {
  id        String     @id @default(cuid())
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole
  startDate DateTime   @default(now())
  endDate   DateTime?

  @@index([groupId])
  @@index([userId])
}

model FeePayment {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  year     Int
  month    Int
  paidAt   DateTime @default(now())
  paidById String?
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidBy   User?    @relation("RecordedPayments", fields: [paidById], references: [id], onDelete: SetNull)

  @@unique([groupId, userId, year, month])
}

model ChatMessage {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  message  String
  imageUrl String?
  videoUrl String?
  sentAt   DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, sentAt])
}

model Comment {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model GroupMedia {
  id           String   @id @default(cuid())
  groupId      String
  url          String
  fileType     String // IMAGE or VIDEO
  uploadedById String
  createdAt    DateTime @default(now())

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model UserProfileCard {
  id              String        @id @default(cuid())
  userId          String
  nickname        String
  profileImageUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships     GroupMember[]

  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Category {
  id        String   @id @default(cuid())
  value     String   @unique
  emoji     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
