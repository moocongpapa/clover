DATABASE_URL="file:./dev.db"
DIRECT_URL="" # Required when using Supabase connection pooler for migrations/db push
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="3650d"
PORT=3000
FRONTEND_URL="https://clover-gilt.vercel.app"
API_PUBLIC_URL="https://clover-backend-vm9k.onrender.com"

# Kakao OAuth (https://developers.kakao.com)
KAKAO_REST_API_KEY=""
KAKAO_REDIRECT_URI="https://clover-gilt.vercel.app/login"

# Dev login without Kakao keys (development only)
DEV_LOGIN_ENABLED="true"

# Kakao Channel (optional — mock when empty)
KAKAO_CHANNEL_ACCESS_TOKEN=""
KAKAO_CLIENT_SECRET=""

# Firebase Admin SDK Service Account JSON (stringified JSON for push notifications)
FIREBASE_SERVICE_ACCOUNT=""
